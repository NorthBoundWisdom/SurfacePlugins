    {
      "id": "round_trip_and_fences",
      "scope": "host",
      "event_capacity": 1024,
      "steps": [
        {
          "at_s": 0,
          "operation": "snapshot",
          "expect": {
            "sequence": "0",
            "known_inputs": {
              "input_a": "minimum",
              "input_b": "minimum",
              "input_c": "minimum",
              "input_d": "minimum"
            },
            "accepted_input_count": 0
          }
        },
        {
          "at_s": 0.1,
          "operation": "input",
          "role": "input_a",
          "value": "maximum",
          "expect": {
            "disposition": "accepted",
            "accepted_input_delta": 1
          }
        },
        {
          "at_s": 0.2,
          "operation": "replay_last_write",
          "expect": {
            "error": "stale_sequence",
            "atomic": true
          }
        },
        {
          "at_s": 0.3,
          "operation": "input",
          "role": "input_a",
          "value": "maximum",
          "expect": {
            "disposition": "ignored",
            "accepted_input_delta": 0
          }
        },
        {
          "at_s": 0.4,
          "operation": "feedback",
          "role": "feedback_state",
          "value": "on",
          "expect": {
            "disposition": "accepted",
            "accepted_input_delta": 0,
            "inputs_unchanged": true
          }
        },
        {
          "at_s": 0.5,
          "operation": "feedback",
          "role": "feedback_progress",
          "value": "maximum",
          "expect": {
            "disposition": "accepted",
            "accepted_input_delta": 0,
            "inputs_unchanged": true
