{
  "schema_version": 1,
  "scenario_id": "surface-control-hardware-independent-v1.4",
  "contract_version": "1.4",
  "source": "hardware",
  "clock": "injected_monotonic",
  "initial_time_s": 0,
  "required_capabilities": [
    "hardware",
    "controls.input_declared"
  ],
  "roles": {
    "button_accepted": {
      "input_kind": "button",
      "encoding": "boolean"
    },
    "button_ignored": {
      "input_kind": "button",
      "encoding": "boolean"
    },
    "input_a": {
      "input_kind": "absolute",
      "encoding": "scalar"
    },
    "touch_input": {
      "input_kind": "button",
      "encoding": "boolean"
    },
    "feedback_progress": {
      "feedback_kind": "value"
    },
    "input_only": {
      "input_kind": "button",
      "encoding": "boolean"
    }
  },
  "scenarios": [
    {
      "id": "accepted_button_edges_and_recovery",
      "scope": "inprocess",
      "event_capacity": 1024,
      "required_roles": [
        "button_accepted"
      ],
      "steps": [
        {
          "at_s": 0,
          "operation": "snapshot",
          "expect": {
            "unknown_inputs": [
              "button_accepted"
            ],
            "sequence": "0",
            "link_state": "connected"
          }
        },
        {
          "at_s": 1,
          "operation": "hardware_input",
          "role": "button_accepted",
          "value": "maximum",
          "expect": {
            "disposition": "accepted",
            "sequence": "1",
            "known_inputs": {
              "button_accepted": "maximum"
            },
            "source": "hardware",
            "origin": "hardware"
          }
        },
        {
          "at_s": 2,
          "operation": "hardware_input",
          "role": "button_accepted",
          "value": "minimum",
          "expect": {
            "disposition": "accepted",
            "sequence": "2",
            "known_inputs": {
              "button_accepted": "minimum"
            }
          }
        },
        {
          "at_s": 3,
          "operation": "hardware_link",
          "link_state": "disconnected",
          "expect": {
            "epoch_changed": true,
            "link_state": "disconnected",
            "sequence": "0",
            "unknown_inputs": [
              "button_accepted"
            ]
          }
        },
        {
          "at_s": 4,
          "operation": "events",
          "expected_scope": "initial",
          "expect": {
            "error": "stale_epoch",
            "atomic": true
          }
        },
        {
          "at_s": 5,
          "operation": "hardware_input",
          "role": "button_accepted",
          "value": "maximum",
          "expect": {
            "error": "invalid_transition",
            "atomic": true,
            "unknown_inputs": [
              "button_accepted"
            ]
          }
        },
        {
          "at_s": 6,
          "operation": "hardware_link",
          "link_state": "connected",
          "expect": {
            "epoch_changed": true,
            "link_state": "connected",
            "sequence": "0",
            "unknown_inputs": [
              "button_accepted"
            ]
          }
        },
        {
          "at_s": 7,
          "operation": "hardware_input",
          "role": "button_accepted",
          "value": "maximum",
          "expect": {
            "disposition": "accepted",
            "sequence": "1",
            "known_inputs": {
              "button_accepted": "maximum"
            }
          }
        },
        {
          "at_s": 8,
          "operation": "input",
          "role": "button_accepted",
          "value": "minimum",
          "expect": {
            "error": "permission_denied",
            "atomic": true,
            "sequence": "1"
          }
        },
        {
          "at_s": 9,
          "operation": "renew",
          "role": "button_accepted",
          "hold_s": 1,
          "expect": {
            "error": "unsupported_hold",
            "atomic": true,
            "sequence": "1"
          }
        },
        {
          "at_s": 10,
          "operation": "reset",
          "expect": {
            "error": "unsupported_tool",
            "atomic": true,
            "sequence": "1"
          }
        },
        {
          "at_s": 11,
          "operation": "events",
          "expect": {
            "event_count": 1
          }
        }
      ]
    },
    {
      "id": "ignored_button_edges_remain_unknown",
      "scope": "inprocess",
      "event_capacity": 1024,
      "required_roles": [
        "button_ignored"
      ],
      "steps": [
        {
          "at_s": 0,
          "operation": "snapshot",
          "expect": {
            "unknown_inputs": [
              "button_ignored"
            ],
            "sequence": "0"
          }
        },
        {
          "at_s": 1,
          "operation": "hardware_input",
          "role": "button_ignored",
          "value": "maximum",
          "disposition": "ignored",
          "reason": "no_binding",
          "expect": {
            "disposition": "ignored",
            "sequence": "1",
            "unknown_inputs": [
              "button_ignored"
            ],
            "inputs_unchanged": true,
            "source": "hardware",
            "origin": "hardware"
          }
        },
        {
          "at_s": 2,
          "operation": "hardware_input",
          "role": "button_ignored",
          "value": "minimum",
          "disposition": "ignored",
          "reason": "no_binding",
          "expect": {
            "disposition": "ignored",
            "sequence": "2",
            "unknown_inputs": [
              "button_ignored"
            ],
            "inputs_unchanged": true
          }
        },
        {
          "at_s": 3,
          "operation": "events",
          "expect": {
            "event_count": 2
          }
        }
      ]
    },
    {
      "id": "position_touch_independent_edges",
      "scope": "inprocess",
      "event_capacity": 1024,
      "required_roles": [
        "input_a",
        "touch_input"
      ],
      "steps": [
        {
          "at_s": 0,
          "operation": "snapshot",
          "expect": {
            "unknown_inputs": [
              "input_a",
              "touch_input"
            ],
            "sequence": "0"
          }
        },
        {
          "at_s": 1,
          "operation": "hardware_input",
          "role": "input_a",
          "value": "maximum",
          "expect": {
            "disposition": "accepted",
            "sequence": "1",
            "known_inputs": {
              "input_a": "maximum"
            },
            "unknown_inputs": [
              "touch_input"
            ]
          }
        },
        {
          "at_s": 2,
          "operation": "hardware_input",
          "role": "touch_input",
          "value": "maximum",
          "expect": {
            "disposition": "accepted",
            "sequence": "2",
            "known_inputs": {
              "input_a": "maximum",
              "touch_input": "maximum"
            },
            "source": "hardware",
            "origin": "hardware"
          }
        },
        {
          "at_s": 3,
          "operation": "hardware_input",
          "role": "input_a",
          "value": "minimum",
          "expect": {
            "disposition": "accepted",
            "sequence": "3",
            "known_inputs": {
              "input_a": "minimum",
              "touch_input": "maximum"
            }
          }
        },
        {
          "at_s": 4,
          "operation": "hardware_input",
          "role": "touch_input",
          "value": "minimum",
          "expect": {
            "disposition": "accepted",
            "sequence": "4",
            "known_inputs": {
              "input_a": "minimum",
              "touch_input": "minimum"
            }
          }
        },
        {
          "at_s": 5,
          "operation": "events",
          "expect": {
            "event_count": 4
          }
        },
        {
          "at_s": 6,
          "operation": "hardware_link",
          "link_state": "connected",
          "expect": {
            "epoch_changed": true,
            "link_state": "connected",
            "sequence": "0",
            "unknown_inputs": [
              "input_a",
              "touch_input"
            ]
          }
        },
        {
          "at_s": 7,
          "operation": "snapshot",
          "expect": {
            "unknown_inputs": [
              "input_a",
              "touch_input"
            ],
            "sequence": "0"
          }
        }
      ]
    },
    {
      "id": "value_feedback_failures_are_atomic",
      "scope": "inprocess",
      "event_capacity": 1024,
      "required_roles": [
        "input_a",
        "feedback_progress",
        "input_only"
      ],
      "steps": [
        {
          "at_s": 0,
          "operation": "snapshot",
          "expect": {
            "unknown_inputs": [
              "input_a",
              "feedback_progress",
              "input_only"
            ],
            "sequence": "0"
          }
        },
        {
          "at_s": 1,
          "operation": "hardware_input",
          "role": "input_a",
          "value": "maximum",
          "expect": {
            "disposition": "accepted",
            "sequence": "1",
            "known_inputs": {
              "input_a": "maximum"
            }
          }
        },
        {
          "at_s": 2,
          "operation": "feedback",
          "role": "feedback_progress",
          "value": "maximum",
          "feedback_kind": "value",
          "expect": {
            "disposition": "accepted",
            "sequence": "2",
            "inputs_unchanged": true,
            "known_inputs": {
              "input_a": "maximum"
            }
          }
        },
        {
          "at_s": 3,
          "operation": "feedback_failure",
          "role": "feedback_progress",
          "value": "minimum",
          "feedback_kind": "value",
          "expect": {
            "error": "test_transport_rejected",
            "atomic": true,
            "sequence": "2",
            "known_inputs": {
              "input_a": "maximum"
            }
          }
        },
        {
          "at_s": 4,
          "operation": "feedback",
          "role": "feedback_progress",
          "invalid_value": "nan",
          "feedback_kind": "value",
          "expect": {
            "error": "invalid_value",
            "atomic": true,
            "sequence": "2"
          }
        },
        {
          "at_s": 5,
          "operation": "feedback",
          "role": "input_only",
          "value": "on",
          "feedback_kind": "indicator",
          "expect": {
            "error": "unsupported_feedback",
            "atomic": true,
            "sequence": "2"
          }
        },
        {
          "at_s": 6,
          "operation": "events",
          "expect": {
            "event_count": 2
          }
        },
        {
          "at_s": 7,
          "operation": "snapshot",
          "expect": {
            "known_inputs": {
              "input_a": "maximum"
            },
            "unknown_inputs": [
              "feedback_progress",
              "input_only"
            ],
            "sequence": "2"
          }
        }
      ]
    }
  ]
}
