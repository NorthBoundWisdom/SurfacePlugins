{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "const": "surface-control-diagnostic-capture"
    },
    "qualification": {
      "const": "software-diagnostic-only"
    },
    "sdk_version": {
      "const": "1.5.0"
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "simulation",
            "hardware"
          ]
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "required_controls": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "required": [
        "source",
        "instance_id",
        "profile_id",
        "profile_version",
        "required_controls"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "interval_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "max_polls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 16777216
        },
        "max_age_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "duration_s",
        "interval_s",
        "max_polls",
        "max_events",
        "max_bytes",
        "max_age_s"
      ]
    },
    "discovery": {
      "type": [
        "object",
        "null"
      ]
    },
    "snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "pages": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "started_s": {
            "type": "number"
          },
          "received_s": {
            "type": "number"
          },
          "page": {
            "type": "object"
          },
          "result": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "required": [
          "started_s",
          "received_s",
          "page",
          "result",
          "error_code"
        ]
      }
    },
    "clock_origin_s": {
      "type": "number"
    },
    "elapsed_s": {
      "type": "number",
      "minimum": 0
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "enum": [
            "setup",
            "error",
            "duration_limit",
            "poll_limit",
            "event_limit"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "exit_code": {
          "enum": [
            0,
            1
          ]
        },
        "event_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "poll_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "unknown_controls": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "pending_events": {
          "type": "boolean"
        }
      },
      "required": [
        "trigger",
        "reason",
        "exit_code",
        "event_count",
        "poll_count",
        "unknown_controls",
        "pending_events"
      ]
    },
    "rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owned_virtual_rehearsal": {
          "const": true
        },
        "physical_evidence": {
          "const": false
        }
      },
      "required": [
        "owned_virtual_rehearsal",
        "physical_evidence"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact",
    "qualification",
    "sdk_version",
    "requested",
    "limits",
    "discovery",
    "snapshot",
    "pages",
    "clock_origin_s",
    "elapsed_s",
    "end"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:surface-control:diagnostic-capture:1",
  "description": "Structural envelope only. Run the offline SDK-based verifier for cross-field, sequence, link and recorded-value invariants. No authenticity or physical qualification.",
  "allOf": [
    {
      "if": {
        "properties": {
          "discovery": {
            "type": "object",
            "properties": {
              "profile": {
                "properties": {
                  "capabilities": {
                    "contains": {
                      "const": "session.owned_virtual_rehearsal"
                    }
                  }
                },
                "required": [
                  "capabilities"
                ]
              }
            },
            "required": [
              "profile"
            ]
          }
        },
        "required": [
          "discovery"
        ]
      },
      "then": {
        "required": [
          "rehearsal"
        ]
      },
      "else": {
        "not": {
          "required": [
            "rehearsal"
          ]
        }
      }
    }
  ]
}
